# Copy this file to `.env` and fill in real values. DO NOT commit `.env`.
# On Vercel, set these same values in Project Settings → Environment Variables.

# ─── Google Slides OAuth ────────────────────────────
# Create in Google Cloud Console → APIs & Services → Credentials
#   Type: "OAuth 2.0 Client ID" → "Web application"
# Enable these APIs:  Google Slides API,  Google Drive API
# Authorized redirect URIs:
#   http://127.0.0.1:8080        (for local dev)
#   https://<your-project>.vercel.app   (for production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080

# ─── Optional ───────────────────────────────────────
# If you want the server to ship a default Claude / Gemini key instead of
# asking the user to paste one, set these. Otherwise leave blank.
# CLAUDE_API_KEY=
# GEMINI_API_KEY=

# ─── Replicate (AI background removal) ──────────────
# Powers /api/bg-remove which calls 851-labs/background-remover.
# Used for clean mascot/asset-pack cutouts instead of canvas chroma-key.
# Get a token at https://replicate.com/account/api-tokens
# (Billing required — pay-as-you-go ~$0.0001/image. Free $5 trial credit
#  given on first card-on-file.)
# If unset, the client falls back to the in-browser canvas chroma-key.
# REPLICATE_API_TOKEN=

# ─── Brandfetch (auto brand-colour extraction) ──────
# https://brandfetch.com/developers
# BRANDFETCH_API_KEY=
