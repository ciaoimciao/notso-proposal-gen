{
  "name": "notso-proposal-gen",
  "version": "1.0.0",
  "private": true,
  "description": "notso.ai proposal generator — 18-slide proposals (PDF + PPTX)",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'no build step — static HTML + python-pptx backend'",
    "test": "node test/smoke.js",
    "smoke": "node test/smoke.js",
    "postinstall": "node -e \"if(!process.env.VERCEL){require('child_process').execSync('npx puppeteer browsers install chrome',{stdio:'inherit'})}\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@sparticuz/chromium-min": "^131.0.1",
    "@vercel/blob": "^2.4.0",
    "puppeteer-core": "^23.5.0"
  },
  "devDependencies": {
    "puppeteer": "^23.5.0"
  }
}
